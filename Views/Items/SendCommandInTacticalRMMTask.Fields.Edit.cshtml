@model Summary.TacticalRMM.Workflows.Task.Command.Send.SendCommandInTacticalRMMViewModel

<div class="row">
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Code">
      <label asp-for="Code">
        دستور<span class="text-danger">*</span>
      </label>
      <textarea rows="7" asp-for="Code" class="form-control"></textarea>
      <span class="hint">دستور مورد نظر جهت اجرای در Tactical-RMM را در این
        فیلد درج نمایید.
      </span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Shell">
      <label asp-for="Shell">
        اجرا توسط<span class="text-danger">*</span>
      </label>
      <select class="form-control" asp-for="Shell">
        <option></option>
        <option value="cmd">CMD</option>
        <option value="powershell">PowerShell</option>
      </select>
      <span class="hint">
        از طریق این فیلد مشخص کنید
        دستور مورد نظر از طریق کدام برنامه اجرا شود.
      </span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Agent">
      <label asp-for="Agent">
       شناسه سیستم<span class="text-danger">*</span>
      </label>
      <input type="text" asp-for="Agent" class="form-control" />
      <span class="hint">
        در این فیلد نام کامپیوتر (Hostname)
        مربوط به کلاینت در Tactical-RMM
        که قصد دارید دستور بر روی آن اجرا شود را وارد کنید.
      </span>
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group" asp-validation-class-for="Client">
      <label asp-for="Client">
        شناسه کلاینت<span class="text-danger">*</span>
      </label>
      <input type="text" asp-for="Client" class="form-control" />
      <span class="hint">
        در این فیلد شناسه کلاینت
         مربوط به کلاینت مورد نظر
        در Tactical-RMM را وارد کنید.
      </span>
    </div>
    <div class="form-group" asp-validation-class-for="Site">
      <label asp-for="Site">
        شناسه سایت<span class="text-danger">*</span>
      </label>
      <input type="text" asp-for="Site" class="form-control" />
      <span class="hint">
        در این فیلد شناسه سایت
        مربوط به کلاینت مورد نظر
        در Tactical-RMM را وارد کنید.
      </span>
    </div>
  </div>
</div>